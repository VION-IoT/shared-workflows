<Project>

    <!-- Mirrors vion-agent-windows/Directory.Build.props: the fixture is only useful as a proof
         if it has the same shape as the repo the lane was built for. net10.0-windows (not plain
         net10.0) and win-x64 only — the CX5130 fleet is all 64-bit LTSC 2019/2021, so no win-x86
         path exists anywhere. -->
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- So the lane's `restore-locked-mode` input has something to gate against. `mesh` sets
             this for the same reason: the published package graph is pinned, not merely resolved. -->
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>

</Project>
