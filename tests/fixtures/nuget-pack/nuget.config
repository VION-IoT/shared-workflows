<?xml version="1.0" encoding="utf-8"?>
<!-- No sources. The project references no package, so its restore needs none, and this keeps it
     off the PrivateFeed source publish-nuget.yml registers: this repository holds no
     AZURE_DEVOPS_PAT, so the proof hands the workflow a placeholder, and a restore that queried the
     feed with it would fail NU1301. -->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
