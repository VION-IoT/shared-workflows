<Project>

    <!-- Mirrors the four callers of dotnet-aot-app.yml (mesh, thingsboard-service-provider,
         hal-raspberry, hal-waveshare-ipcbox): every restore is locked, so a lock file out of step with
         its project fails the restore instead of being rewritten. The Linux publishes run in an Alpine
         SDK image pinned to the version in global.json, and on any other SDK the lock files' records of
         the SDK-injected ILCompiler fail the restore with NU1004. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <InvariantGlobalization>true</InvariantGlobalization>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <RestoreLockedMode>true</RestoreLockedMode>
    </PropertyGroup>

</Project>
