<Project>

    <!-- Every restore is locked, so a lock file out of step with its project fails the restore
         instead of being rewritten. The lock files record the SDK-injected ILCompiler at the version
         the global.json SDK bundles, so a restore on any other SDK fails with NU1004. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <InvariantGlobalization>true</InvariantGlobalization>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <RestoreLockedMode>true</RestoreLockedMode>
        <!-- NU1903 stays a warning: GHSA-p3jp-9v83-76w9 flags the ILCompiler the pinned SDK
             bundles, and the next SDK's image is on an Alpine the workflow does not pin. The
             fixture ships nothing, so the advisory has nothing to reach here; it is listed in
             the restore log, not muted. -->
        <WarningsNotAsErrors>NU1903</WarningsNotAsErrors>
    </PropertyGroup>

</Project>
