<Project>

    <!-- Every restore is locked, so a lock file out of step with its project fails the restore
         instead of being rewritten. The lock files record the SDK-injected ILCompiler at the version
         the global.json SDK bundles, so a restore on any other SDK fails with NU1004. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <InvariantGlobalization>true</InvariantGlobalization>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <RestoreLockedMode>true</RestoreLockedMode>
    </PropertyGroup>

</Project>
